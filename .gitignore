# macOS
.DS_Store

# graphify harness: keep the portable, queryable graph artifacts committed
# (graph.json, GRAPH_REPORT.md, graph.html, labels) so a fresh clone on
# another machine has the knowledge graph without needing to regenerate it.
# Exclude machine-specific absolute paths, regenerable local caches, and
# dated snapshot backups — none of these help reproduce the repo elsewhere.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.DS_Store
graphify-out/cache/
graphify-out/.graphify_analysis.json
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify's `add` scratch dir (holds fetched papers/pages before merging into the graph)
raw/

# Python virtual environments (regenerate per README setup instructions)
.libtorch-venv/
.book-to-skill-venv/

# Local build scratch
.audiopluginhost-build/

# Generated plugin projects are scaffolded one level up from this repo (see
# "Generating a plugin" in README.md — create_project.py's
# --destination-parent points at ..), so they never land inside this working
# tree and never need a per-project entry here.

# Not a submodule — a Pure Data/plugdata skill unrelated to JUCE plugin
# generation. Clone separately if wanted: github.com/shortwavlabs/agent-skills
agent-skills/
.agents/

# Nested cache inside a submodule
juce-agent-toolkit/graphify-out/

# Python bytecode cache
__pycache__/
*.pyc
